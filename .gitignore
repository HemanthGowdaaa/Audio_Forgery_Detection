# Ignore WAV audio files (they are large and numerous)
*.WAV
*.wav

# Ignore zip files
*.zip

# Python files
__pycache__/
*.py[cod]
*$py.class

# Environment
.env
.venv
env/
venv/
ENV/

# System / IDE
.DS_Store
.vscode/
.idea/

# Local model checkpoint or graphs
*.png

# Dataset and cache directories
dataset/release_in_the_wild/
cache/

# Training outputs, logs, and checkpoints
outputs/

# Django generated (collectstatic output, db)
django_backend/staticfiles/
django_backend/media/
django_backend/db.sqlite3
django_backend/outputs/

# Do NOT ignore render.yaml — needed for Render deployment
# !render.yaml
